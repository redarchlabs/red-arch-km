# =============================================================================
# Red Arch Knowledge Management Platform - Environment Configuration
# Copy this file to .env and fill in the values. NEVER commit .env to git.
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=redarch
# REQUIRED: set a strong password
POSTGRES_PASSWORD=
POSTGRES_DB=redarch_km
# The APP connects as the non-superuser `km_app` role (created by
# docker/init-db.sql) so PostgreSQL RLS is actually enforced. Cross-org paths
# opt into the `app.bypass` GUC (migration 034). Alembic MIGRATIONS run as the
# admin POSTGRES_USER (`make migrate` uses DATABASE_URL_LOCAL). Keep these split.
DATABASE_URL=postgresql+asyncpg://km_app:km_app_dev@postgres:5432/${POSTGRES_DB}

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Qdrant ---
QDRANT_URL=http://qdrant:6333
# Optional: set if using Qdrant Cloud
QDRANT_API_KEY=

# --- Neo4j ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
# REQUIRED: set a strong password
NEO4J_PASSWORD=

# --- OpenAI ---
# REQUIRED: your OpenAI API key (central fallback; per-org keys override)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Vision model for the "ai" upload extraction method
OPENAI_OCR_MODEL=gpt-5-mini

# --- Reranking (optional; brain-api) ---
# Cross-encoder re-scoring of retrieved passages. Dense search embeds the query and the
# passage separately, so it ranks on topical similarity and misses paraphrase — "how many
# people can each ship handle" did not retrieve "Standard Crew Complement: 5,500 officers
# and crew" from the document that answers it. A reranker scores the pair together.
#
# Empty URL = off, and retrieval behaves exactly as it did before. OpenAI has no rerank
# API, so a hosted-OpenAI deployment either leaves this blank or points it at a provider
# that has one. Any Cohere-shaped /rerank endpoint works:
#   local     http://<host>:8096/v1   llama.cpp --reranking (see run-local-llm-stack.sh)
#   Jina      https://api.jina.ai/v1  + RERANK_API_KEY
#   Cohere    https://api.cohere.com/v2 + RERANK_API_KEY
# blank = reranking off
RERANK_BASE_URL=
# required by hosted providers; llama.cpp ignores it
RERANK_MODEL=
# only for hosted providers
RERANK_API_KEY=
# dense hits scored per query before the top N are kept
RERANK_CANDIDATES=30

# How many RANKED passages a chat answer is grounded in (was 5). Not the prompt size —
# same-document expansion adds more on top. 5 was too tight for an "each X" question: one
# document could take every slot, squeezing out a second document that also answered.
# Raising it too far costs accuracy, not speed: on the demo corpus, 10 let a template
# document into the context and the model invented a ship from it. Measure before raising.
CHAT_CHUNK_LIMIT=8

# --- Object storage (MinIO / S3-compatible) — uploaded document originals ---
# Shared by the API (stores originals on upload) and the worker (downloads for
# OCR/extraction). STORAGE_ENDPOINT is the S3 API URL. Containers use the
# service name (minio:9000); host processes in the hybrid dev layout (run-stack)
# use http://localhost:9000 — set that in .env.host, NOT here. Do NOT use
# "km2_minio": botocore rejects endpoint hosts containing underscores.
STORAGE_ENDPOINT=http://minio:9000
# MinIO root user (dev default)
STORAGE_ACCESS_KEY=minioadmin
# REQUIRED: MinIO root password (set a strong value)
STORAGE_SECRET_KEY=
# Auto-created by the createbuckets init container
STORAGE_BUCKET=km-documents
STORAGE_REGION=us-east-1
# Upload size cap (API rejects at the boundary)
MAX_FILE_SIZE_MB=50

# --- Clerk (identity provider) — backend verifier ---
# Backends (Go api-go + Python api) verify the session token by its issuer: the
# token's `iss` must match CLERK_JWT_ISSUER. Clerk default session tokens carry
# NO `aud`; the verifier instead enforces `azp` against CLERK_ALLOWED_AZP
# (mandatory when Clerk is enabled).
# Clerk Frontend API URL, e.g. https://clerk.example.com or https://<slug>.clerk.accounts.dev
CLERK_JWT_ISSUER=
# CLERK_ALLOWED_AZP must match Clerk's emitted `azp` (the UI Origin) BYTE-FOR-BYTE:
# scheme+host, no trailing slash, include the port only if the origin has one.
# A mismatch fails closed (rejects all Clerk tokens), so set it carefully.
# REQUIRED w/ Clerk: comma-separated allowlist of UI origins (authorized parties)
CLERK_ALLOWED_AZP=http://localhost:3002
# Clerk Backend API secret (sk_…); also used by @clerk/nextjs server (middleware/SSR)
CLERK_SECRET_KEY=

# Comma-separated emails that become site admins on their first sign-in. A profile
# row only exists after a login, so this is the only way to authorize an admin who
# has never signed in. Additive: it never demotes, and removing an address does not
# revoke — demote from the site-admin console instead.
SITE_ADMIN_EMAILS=

# --- Clerk — UI (@clerk/nextjs) ---
# The publishable key is exposed to the browser; the secret key (above) is read
# server-side by @clerk/nextjs. Sign-in/up live at /login and /sign-up.
# Clerk publishable key (pk_…)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Name of the Clerk JWT template (Phase 0, dashboard) that injects claims into
# the session token the UI sends as Bearer. SECURITY-CRITICAL: the template MUST
# emit email, email_verified, AND username — the api-go verifier provisions on
# email/username and gates the verified-email user RELINK on email_verified
# (omitting email = silent membership loss; omitting email_verified = first-login
# 403 lockout for migrated users). Verify the live token end-to-end against a
# real migrated profile before cutover. NOTE: Clerk renders an unknown shortcode
# as a LITERAL string, so the email_verified shortcode MUST be exactly
# {{user.email_verified}} (verified live to emit a boolean) — `user.
# primary_email_address_verified` is NOT a valid shortcode and renders literally,
# which makes email_verified never == true and 403-locks out every migrated user.
#   email          = {{user.primary_email_address}}
#   email_verified = {{user.email_verified}}
#   username       = {{user.username}}
NEXT_PUBLIC_CLERK_JWT_TEMPLATE=redarch-km

# --- API Service ---
# REQUIRED: random string for JWT signing
API_SECRET_KEY=
API_DEBUG=false
API_CORS_ORIGINS=["http://localhost:3002"]
API_RATE_LIMIT_PER_MINUTE=60

# --- Enterprise API (/api/v1, authenticated by org API keys) ---
# per-key request quota (Redis-enforced)
API_KEY_RATE_LIMIT_PER_MINUTE=600
# coarse per-client-IP quota (pre-auth flood guard)
API_IP_RATE_LIMIT_PER_MINUTE=1200
# serve /api/v1/docs; set false to hide in hardened prod
API_DOCS_ENABLED=true

# --- Brain API ---
# REQUIRED: shared secret for service-to-service auth
BRAIN_API_KEY=
BRAIN_CHUNK_COLLECTION_SUFFIX=chunks
BRAIN_DOCUMENT_COLLECTION_SUFFIX=documents
BRAIN_MAX_TOKENS=16000

# --- Internal API (worker → api callbacks) ---
# Separate from BRAIN_API_KEY so compromise of one doesn't grant the other.
# The api service rejects internal callbacks if this is empty.
# REQUIRED: shared secret for worker→api callbacks
INTERNAL_API_KEY=
# Where the worker POSTs processing-status callbacks
API_URL=http://api:8000

# --- Public URLs + Email ---
# PUBLIC_BASE_URL is used to mint user-facing links (intake forms, etc.) that are
# emailed to external users. Points at the Next.js UI, not the API.
# REQUIRED: public-facing URL for user links
PUBLIC_BASE_URL=http://localhost:3002

# SMTP configuration for intake-form invitations. Email is disabled unless both
# smtp_host and smtp_from are set, so dev/test never tries to send real mail.
# e.g., smtp.gmail.com, smtp.sendgrid.net
SMTP_HOST=
# 587 (STARTTLS) or 465 (SMTPS)
SMTP_PORT=587
# e.g., apikey (SendGrid), or your email address
SMTP_USERNAME=
# SMTP password or API key
SMTP_PASSWORD=
# Email address to send from, e.g., noreply@example.com
SMTP_FROM=
# Use TLS (587) or not (465 typically uses implicit TLS)
SMTP_USE_TLS=true

# --- Application-Level Encryption ---
# Encryption key for per-org third-party credentials (OpenAI keys, etc.) at rest.
# A dev default keeps local/test environments working; production MUST set this
# to a unique, random string (recommended: `python -c 'import secrets; print(secrets.token_urlsafe(32))'`).
# REQUIRED in production: 32+ character random string
ORG_ENCRYPTION_KEY=

# --- Workflow Security ---
# Allow-listed webhook hosts for workflow send_webhook actions (SSRF guard).
# Comma-separated list of allowed domains (no scheme/path). Empty = webhooks disabled.
# Example: example.com,api.slack.com,webhooks.example.com
WORKFLOW_WEBHOOK_ALLOWLIST=

# --- Workflow responsiveness ---
# How often the beat sweeps resume parked work. These are the FLOOR under every wait a
# workflow can express: a node asking for a 3-second timer is really checked once per
# sweep, so a sweep slower than the shortest delay silently makes that delay meaningless.
#
# Both defaults are set for a quiet server rather than for a person waiting in a room. Left
# alone, a robot that detected the end of a spoken verse on time went unanswered for 89
# seconds, because run_timers had not come round. Lower them wherever a human is watching
# the result; raise them for a large deployment where nothing is interactive.
WORKFLOW_TIMER_INTERVAL=2    # resume delayed runs + fire scheduled workflows (default 30)
WORKFLOW_TOKEN_INTERVAL=2    # BPMN token engine: reactivate parked tokens (default 10)

# --- Celery ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=red-arch-km
LOG_LEVEL=INFO

# --- pgAdmin (dev only) ---
PGADMIN_DEFAULT_EMAIL=admin@redarchlabs.com
# Set for local dev only
PGADMIN_DEFAULT_PASSWORD=

# --- Flower (dev only) ---
# Set for local dev only
FLOWER_BASIC_AUTH=admin:
