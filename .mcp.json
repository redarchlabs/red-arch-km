{
  "mcpServers": {
    "km2": {
      "command": "node",
      "args": [
        "tools/km2-mcp/dist/index.js"
      ],
      "env": {
        "KM2_APP_URL": "http://localhost:3002",
        "KM2_API_URL": "http://localhost:8000/api",
        "KM2_BROWSER_CHANNEL": "chrome",
        "KM2_CLERK_JWT_TEMPLATE": "redarch-km",
        "KM2_USER_DATA_DIR": "~/.km2-mcp/profile-lesson"
      }
    }
  }
}
